<odoo>
    <record id="view_gym_attendance_wizard_form" model="ir.ui.view">
        <field name="name">gym.attendance.wizard.form</field>
        <field name="model">gym.attendance.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="class_id" invisible="1"/>
                <field name="line_ids">
                    <tree editable="bottom">
                        <field name="member_id" readonly="1"/>
                        <field name="present"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_confirm_attendance" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>