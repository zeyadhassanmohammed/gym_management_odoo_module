<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- الباقة الشهرية -->
        <record id="plan_monthly" model="membership.plan">
            <field name="name">Monthly</field>
            <field name="duration_months">1</field>
            <field name="price">500</field>
            <field name="class_credits">8</field>
        </record>

        <!-- الباقة الربع سنوية -->
        <record id="plan_quarterly" model="membership.plan">
            <field name="name">Quarterly</field>
            <field name="duration_months">3</field>
            <field name="price">1200</field>
            <field name="class_credits">30</field>
        </record>

        <!-- الباقة السنوية -->
        <record id="plan_annual" model="membership.plan">
            <field name="name">Annual</field>
            <field name="duration_months">12</field>
            <field name="price">4000</field>
            <field name="class_credits">120</field>
        </record>

        <!-- باقة الـ VIP -->
        <record id="plan_vip" model="membership.plan">
            <field name="name">VIP</field>
            <field name="duration_months">12</field>
            <field name="price">6000</field>
            <field name="class_credits">999</field>
        </record>

    </data>
</odoo>